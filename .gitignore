# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# capturas automáticas do Playwright MCP do agente (producao/claude/ferramental.md, seção 2)
/.playwright-mcp/

# o kit de produção: interno, vive no repositório principal. Este repositório é a cópia pública que a Hostinger publica
/producao/

# os registros de produção dos sites de demonstração (briefing fictício, identidade, decisões, painéis, QA): internos
/registros/

# régua (relatório local)
/.regua/

# Claude Code: o que é só desta máquina (as permissões locais, a trava das tarefas agendadas) e o binário do motor do
# Impeccable (12 MB). O detector travado vem do node_modules (impeccable 4.1.0, @impeccable/cli-darwin-arm64 0.1.5);
# para a habilidade usá-lo: cp node_modules/@impeccable/cli-darwin-arm64/bin/impeccable .claude/skills/impeccable/scripts/bin/darwin-arm64/
/.claude/settings.local.json
/.claude/scheduled_tasks.lock
/.claude/skills/impeccable/scripts/bin/
